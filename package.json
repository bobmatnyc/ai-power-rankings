{
  "name": "aipowerranking",
  "version": "0.4.5",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3007",
    "build": "npm run generate-changelog && npm run generate-categories && next build",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:logos": "tsx scripts/lint-logos.ts",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "generate-categories": "npx tsx scripts/generate-static-categories.ts",
    "generate-changelog": "npx tsx scripts/generate-changelog-data.ts",
    "migrate:prod-to-dev": "tsx scripts/migrate-prod-to-dev.ts",
    "db:compare": "tsx scripts/compare-db-schemas.ts",
    "db:verify-tools": "tsx scripts/verify-tools-schema.ts",
    "db:verify-summaries": "tsx scripts/verify-monthly-summaries.ts",
    "db:apply-scoring": "tsx scripts/apply-scoring-migration.ts",
    "db:apply-summaries": "tsx scripts/apply-monthly-summaries-migration.ts",
    "migrate-tool-data": "tsx scripts/migrate-tool-data-to-top-level.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "gate:local": "node scripts/local-gate.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:api": "playwright test tests/e2e/api.spec.ts",
    "test:ui": "playwright test --grep-invert 'api.spec.ts'",
    "test:report": "playwright show-report test-results/html",
    "test:install": "playwright install --with-deps",
    "release": "bash scripts/release.sh patch",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "version:check": "node -p \"require(\"./package.json\").version\"",
    "verify": "bash scripts/verify-deployment.sh",
    "verify:staging": "bash scripts/verify-deployment.sh ${STAGING_URL:-https://aipowerranking.vercel.app}",
    "test:visual": "playwright test -c tests/visual/playwright.design.config.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.8",
    "@hookform/resolvers": "^5.9.2",
    "@neondatabase/serverless": "^0.10.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/uuid": "^10.0.0",
    "@upstash/ratelimit": "^2.2.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^1.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "fs-extra": "^11.4.1",
    "googleapis": "^160.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.28",
    "pdf-parse": "^1.1.4",
    "pino": "^9.14.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "resend": "^6.34.1",
    "schema-dts": "^1.1.5",
    "sharp": "^0.34.4",
    "tailwind-merge": "^3.7.0",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.19.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.6.2",
    "critters": "^0.0.25",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^26.1.0",
    "postcss": "^8",
    "puppeteer": "^24.43.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
