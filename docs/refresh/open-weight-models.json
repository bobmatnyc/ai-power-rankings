  "sources": {
    "huggingface_hub_api": {
      "url": "https://huggingface.co/docs/hub/api",
      "use": "licence tag, safetensors parameter total, repo creation date, public download and like counts, community benchmark results",
      "terms": "Public unauthenticated read API; rate limited. Benchmark results are submitted by the community and are not verified unless the Hub marks them so."
    },
    "model_cards": {
      "url": "https://huggingface.co/<hf_repo>",
      "use": "licence text, active parameter count",
      "terms": "Each model card states its own licence; a licence value of 'other' means the card links a custom licence that has not been reviewed here."
    }
  },
  "basis": {
    "rows": "Every row is a model family or line in the D91 sense, with one current flagship Hugging Face repo that the collector reads. Older versions of a line are not seeded separately.",
    "flagship_choice": "Within a family, take the newest seeded generation, then the largest repo of that generation. Each row's flagship_basis says which repos were considered. Licence, parameters_b and release_date come from the flagship repo, re-checked against the Hub API on checked_at.",
    "parameters_b": "Hub safetensors total / 1e9, one decimal.",
    "active_parameters_b": "Stated on the model card or in the reviewed tool-kind sheet; null when neither states it.",
    "release_date": "Hub repository creation date; not necessarily the public announcement date.",
    "price": "Open weights have no list price. A hosted price depends on the provider; left null until the owner picks a provider.",
    "restricted_licence": "A row is restricted_licence = true when the Hub licence tag is 'other' or cc-by-nc-*. Those rows are kept and carry licence_review = pending. Their licence texts are reviewed before activation, not by this seed.",
    "benchmarks": "Community Hub eval results are recorded as unverified history leaves only. No scoring code reads them.",
    "activation": "Rows load inactive. Activation follows the scheduled wire-in and one clean run."
  },
